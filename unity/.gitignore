# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.booproj
*.unityproj
.vs/
.idea/

# Created by Founders/Editor/BuildScript.cs (scene + materials are generated from code)
/Assets/Generated/
/Assets/Generated.meta

# .NET test output
/CoreTests/**/bin/
/CoreTests/**/obj/
/CompileCheck/bin/
/CompileCheck/obj/

# Our own .NET projects (Unity-generated ones above stay ignored)
!/CoreTests/**/*.csproj
!/CoreTests/*.csproj
!/CompileCheck/*.csproj

# Created by URP when the pipeline asset is generated
/Assets/UniversalRenderer.asset*
/Assets/UniversalRenderPipelineGlobalSettings.asset*
/Assets/DefaultVolumeProfile.asset*
/Assets/Settings/
/Assets/Settings.meta
# Binary art: Unity generates import settings (see Editor/ArtSetup.cs)
/Assets/Art/**/*.png.meta
/Assets/Art/**/*.jpg.meta
/Assets/Art/**/*.fbx.meta
/Assets/Art/**/*.hdr.meta
/CompileCheck/Modules.props
# Licensed nature packs (Ultimate Nature PRO + Starter): imported in the editor, never committed
/Assets/Innerverse Games/
/Assets/Innerverse Games.meta
/Assets/InnerverseInteractive/
/Assets/InnerverseInteractive.meta
