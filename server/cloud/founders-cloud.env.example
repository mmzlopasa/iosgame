# Copy to /etc/founders-cloud.env (sudo chmod 600 /etc/founders-cloud.env) and put your own password in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=founders
DB_PASSWORD=change-me
DB_NAME=founders
HOST=127.0.0.1
PORT=8787
# Admin page https://<your domain>/admin: your own password, at least 12 characters (empty = admin page off).
ADMIN_PASSWORD=
